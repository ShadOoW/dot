#!/bin/sh
# AWS VPN Client launcher.
#
# Historical note: through 5.2.x the client's built-in SAML browser launch was
# broken on Linux — it made an XDG-portal / .NET call that spawned no process at
# all — so this wrapper polled the client log for the SAML URL and opened it
# with xdg-open. As of 5.3.1 the client opens the browser itself, which turned
# the wrapper's copy into a duplicate login tab; the workaround was removed
# (see git history if a future version regresses).

exec "/opt/awsvpnclient/AWS VPN Client" "$@"
