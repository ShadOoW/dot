[init]
	defaultBranch = main
[user]
	name = Younes El Alami
	email = shadoow.ma@gmail.com
[github]
	user = ShadOoW
[alias]
	l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	rb = rebase origin/master --autostash
	st = status
	sts = status --short
	fa = fetch --all --prune --tags
[color]
	ui = yes
[color "status"]
	added = magenta bold
	changed = green bold
	untracked = yellow bold
[core]
	editor = nano
	excludesfile = ~/.config/git/ignore
[push]
	autoSetupRemote = true
[safe]
	directory = /mnt/share/brain
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
# Machine-local overrides (untracked; keep for per-machine git settings)
[include]
	path = ~/.gitconfig.local

# --- Per-identity email override (keep LAST so it wins) ---
# Work repos live under /data/code/work/ (e.g. the lee-bruce-work org).
# The author name is shared; only the email switches to the bruce.work address.
[includeIf "gitdir:/data/code/work/"]
	path = ~/.gitconfig-work
