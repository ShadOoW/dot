# ─────────────────────────────────────────────────────────────────────────
# Global git ignore — applies to EVERY git repository on this machine.
# This is git's XDG default (~/.config/git/ignore) and is also pointed at
# explicitly by core.excludesfile in ~/.gitconfig.
# Managed in dotfiles: packages/git/home/.config/git/ignore
#
# Keep this for machine-wide noise only. Project-specific ignores belong in a
# repo's own .gitignore; personal per-repo ignores belong in .git/info/exclude.
# ─────────────────────────────────────────────────────────────────────────

# Claude Code per-machine local settings
**/.claude/settings.local.json

# Serena MCP scratch dirs (see ~/nuke-serena.sh to remove Serena entirely)
.serena/

# nosy query-performance watcher scratch dirs
.nosy/

# playwright-cli screenshot/snapshot/console artifacts. Written into the cwd of
# whatever repo it is driven from, so it is machine-wide noise, not one repo's.
.playwright-cli/

# OS noise
.DS_Store
Thumbs.db
desktop.ini
