[Unit]
Description=agentmemory persistent memory daemon
After=network-online.target
Wants=network-online.target
# Give up instead of looping: this unit already restart-looped at ~590 restarts/boot on
# status=203/EXEC when fnm's default alias moved (see AGENTS.md) — RestartSec=5 never
# trips systemd's default 5-in-10s limit. Three failures in a minute now leave a FAILED
# unit that `dot doctor` flags.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# The daemon reads OPENAI_API_KEY (detection order puts it first); the secrets dir is
# single-sourced on DEEPSEEK_API_KEY and is sourced wholesale into every login shell by
# .zprofile.d/05-secrets.zsh, so the rename happens here, in the unit, and nowhere else.
ExecStart=/bin/sh -c 'exec env OPENAI_API_KEY="$DEEPSEEK_API_KEY" %h/.cache/managed-fnm/aliases/default/bin/agentmemory'
Restart=on-failure
RestartSec=5s
EnvironmentFile=-%h/.config/secrets/deepseek
EnvironmentFile=-%h/.agentmemory/.env

[Install]
WantedBy=default.target
