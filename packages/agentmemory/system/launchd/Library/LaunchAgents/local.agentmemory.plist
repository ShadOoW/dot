<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.agentmemory</string>
    <key>ProgramArguments</key>
    <array>
        <string>HOME_PATH/.cache/managed-fnm/aliases/default/bin/agentmemory</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>RestartAttempts</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/agentmemory.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/agentmemory.stderr.log</string>
</dict>
</plist>