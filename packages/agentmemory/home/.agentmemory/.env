# =============================================================================
# agentmemory configuration
# =============================================================================
#
# Secrets (MINIMAX_API_KEY, MINIMAX_API_BASE, MINIMAX_MODEL) are sourced from
# ~/.config/secrets/minimax via the zsh secrets loader — do not set them here.
#
# Detection order: OPENAI_API_KEY → MINIMAX_API_KEY → ANTHROPIC_API_KEY
# → GEMINI_API_KEY → OPENROUTER_API_KEY → noop.

# -----------------------------------------------------------------------------
# 1. LLM provider
# -----------------------------------------------------------------------------
#
# MINIMAX_API_KEY, MINIMAX_API_BASE, MINIMAX_MODEL → from ~/.config/secrets/minimax

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...

# MAX_TOKENS=4096
# AGENTMEMORY_LLM_TIMEOUT_MS=60000

# Opt-in Claude-subscription fallback — off by default (can trigger Stop-hook recursion in Claude Code)
# AGENTMEMORY_ALLOW_AGENT_SDK=true

# FALLBACK_PROVIDERS=anthropic,gemini

# -----------------------------------------------------------------------------
# 2. Embedding provider
# -----------------------------------------------------------------------------

EMBEDDING_PROVIDER=local                       # local | openai | voyage | cohere | gemini | openrouter

# VOYAGE_API_KEY=pa-...
# COHERE_API_KEY=...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# -----------------------------------------------------------------------------
# 3. Auth & security
# -----------------------------------------------------------------------------

# AGENTMEMORY_SECRET=your-secret-here

# -----------------------------------------------------------------------------
# 4. Search tuning
# -----------------------------------------------------------------------------

# BM25_WEIGHT=0.4
# VECTOR_WEIGHT=0.6
# AGENTMEMORY_GRAPH_WEIGHT=0.2
# TOKEN_BUDGET=2000
# MAX_OBS_PER_SESSION=500
# SUMMARIZE_CHUNK_SIZE=400
# SUMMARIZE_CHUNK_CONCURRENCY=6

# -----------------------------------------------------------------------------
# 5. Behaviour flags
# -----------------------------------------------------------------------------

AGENTMEMORY_AUTO_COMPRESS=true
AGENTMEMORY_INJECT_CONTEXT=true
CONSOLIDATION_ENABLED=true
# CONSOLIDATION_DECAY_DAYS=30
GRAPH_EXTRACTION_ENABLED=true
# GRAPH_EXTRACTION_BATCH_SIZE=8
# AGENTMEMORY_REFLECT=true
# AGENTMEMORY_DROP_STALE_INDEX=true
# AGENTMEMORY_IMAGE_EMBEDDINGS=true

# -----------------------------------------------------------------------------
# 6. CLI / runtime knobs
# -----------------------------------------------------------------------------

AGENTMEMORY_TOOLS=all                          # core (7 tools) | all (51 tools)
# AGENTMEMORY_DEBUG=1
# AGENTMEMORY_FORCE_PROXY=1
# AGENTMEMORY_PROBE_TIMEOUT_MS=2000
# AGENTMEMORY_URL=http://localhost:3111
# AGENTMEMORY_VIEWER_URL=http://localhost:3113
# AGENTMEMORY_EXPORT_ROOT=~/agentmemory-backup

# STANDALONE_MCP=1
# STANDALONE_PERSIST_PATH=~/.agentmemory/local.db

# Snapshot exporter
# SNAPSHOT_ENABLED=true
# SNAPSHOT_DIR=~/.agentmemory/snapshots
# SNAPSHOT_INTERVAL=3600

# Team sharing
# TEAM_MODE=shared
# TEAM_ID=acme
# USER_ID=rohit

# -----------------------------------------------------------------------------
# 7. Ports
# -----------------------------------------------------------------------------

# III_REST_PORT=3111
# III_STREAMS_PORT=3112
# III_ENGINE_URL=ws://localhost:49134

# -----------------------------------------------------------------------------
# 8. Claude Code bridge (opt-in)
# -----------------------------------------------------------------------------

# CLAUDE_MEMORY_BRIDGE=true
# CLAUDE_PROJECT_PATH=/path/to/your/project
# CLAUDE_MEMORY_LINE_BUDGET=200

# -----------------------------------------------------------------------------
# 9. Obsidian export (opt-in)
# -----------------------------------------------------------------------------

# OBSIDIAN_AUTO_EXPORT=true
