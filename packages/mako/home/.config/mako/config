sort=-priority
max-visible=5
background-color=#285577ff
border-color=#7dcfff
group-by=app-name,urgency
default-timeout=5000
anchor=top-left

[urgency=high]
background-color=#772855ff
default-timeout=8000
group-by=urgency,app-name

[urgency=critical]
default-timeout=0

[urgency=low]
background-color=#777777ff

[category=mpd]
background-color=#000000BB
default-timeout=2000
group-by=category

[app-name=signal-sync]
background-color=#2d5a27ff
default-timeout=8000
group-by=app-name

[app-name=Vivaldi summary~="Download"]
ignore-timeout=1
default-timeout=2000
