sort=-priority
max-visible=5
background-color=#285577ff
border-color=#7dcfff
group-by=app-name,urgency
default-timeout=5000
anchor=top-left

[urgency=high]
background-color=#772855ff
default-timeout=8000
group-by=urgency,app-name

[urgency=critical]
# Red and persistent. default-timeout=0 never expires; ignore-timeout=1 makes that stick
# even when the sender asks for a short timeout. Used by packages/oom's OOM notifier —
# an OOM kill must not scroll past unnoticed.
background-color=#801420ff
border-color=#f7768e
border-size=3
default-timeout=0
ignore-timeout=1

[urgency=low]
background-color=#777777ff

[category=mpd]
background-color=#000000BB
default-timeout=2000
group-by=category

[app-name=signal-sync]
background-color=#2d5a27ff
default-timeout=8000
group-by=app-name

[app-name=Vivaldi summary~="Download"]
ignore-timeout=1
default-timeout=2000
