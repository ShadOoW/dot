#!/usr/bin/env sh
# The launcher for fleet's own CLIs — one file, dispatched by the name it was called as.
#
# `brucelee` is not a binary. It is /data/code/fleet/apps/brucelee/cli.ts, a Bun entry point
# inside the fleet workspace, resolved through that workspace's node_modules. Two facts have
# to be true before it runs, neither the same on every host, so neither is written down here.
#
# ## Where the code is
#
# The fleet checkout, recorded once per host by packages/dot/bootstrap.sh and read here.
# This is the same record `dot`'s own launcher reads for the same reason, and the header of
# that file is the argument for it: four successive revisions of it named an absolute path
# instead, and each was wrong on some host.
#
#   2026-05-15  $HOME/.config/dotfiles/dot.ts
#   2026-05-25  $HOME/.config/dotfiles/dot.ts, with --cwd
#   2026-07-10  /data/config/dot/dot.ts
#   2026-08-24  /data/code/fleet/apps/dot/dot.ts
#
# ragnarok's hosts/desktop could have carried a writeShellScriptBin instead and had the path
# baked into a store derivation. That would be the fifth entry in that table, in the one layer
# that is supposed to outlive the tree it names: migration.md §14.6 records that fleet is a
# candidate for deletion, so a system generation must not contain /data/code/fleet.
#
# FLEET_ROOT overrides the record, for running a branch of the kit without touching it.
#
# ## Which runtime
#
# Plain `bun`. None of the three commands loads a native module: brucelee stopped importing
# @kit/lake, and with it DuckDB's binding, when it moved onto the lake's published tables
# (ops-next step 12h, 2026-09-30). Until then this ran the desk's `bun-native`, `bun` with
# libstdc++'s directory prefixed to LD_LIBRARY_PATH, which every child process inherited. If a
# command imports a native binding again, `error: libstdc++.so.6: cannot open shared object
# file` is the sign, and `bun-native` (ragnarok hosts/desktop/default.nix) is the runtime.
#
# ## Why one file and not one per command
#
# The body below is the whole of the logic, and a second copy of it is a second thing to keep
# true. `brucelee-tui` beside this file is a symlink to it; the case statement reads the name
# it was invoked as and picks the entry point. Adding a command is one line there and one
# symlink — and an unrecognised name is an error rather than a default, so a mislinked file
# says so instead of silently running the CLI.
set -eu

# Before following any symlink: this is the *invoked* name, which is what selects the entry
# point. `dot link` puts a symlink in ~/.local/bin pointing at this file, so $0 is the name
# the user typed and the file this comment is in may have any other name entirely.
case ${0##*/} in
  brucelee) entry=apps/brucelee/cli.ts ;;
  brucelee-tui) entry=apps/brucelee/tui.ts ;;
  nosy) entry=apps/nosy/nosy.ts ;;
  *)
    echo "fleet: no entry point is registered for '${0##*/}'." >&2
    echo "       this launcher dispatches on the name it is called as; see the case" >&2
    echo "       statement in packages/fleet/home/.local/bin/brucelee." >&2
    exit 2
    ;;
esac

state="${XDG_STATE_HOME:-$HOME/.local/state}/dot"
record="$state/fleet-root"

# Whichever of the two sources supplied the path is carried alongside it, because the
# failure below names it. Blaming the record file for a path that came from FLEET_ROOT
# sends the reader to re-run bootstrap.sh against a record that is already correct, and
# the override is the case where they are most likely to be mid-experiment and least
# likely to want a write to $XDG_STATE_HOME.
root="${FLEET_ROOT:-}"
if [ -n "$root" ]; then
  origin="FLEET_ROOT"
  remedy="unset FLEET_ROOT, or point it at a fleet checkout"
else
  origin="$record"
  remedy="re-run <payload>/packages/dot/bootstrap.sh /path/to/fleet"
  if [ -f "$record" ]; then
    root=$(cat "$record")
  fi
fi

if [ -z "$root" ]; then
  echo "fleet: this host has no fleet checkout recorded at $record." >&2
  echo "       run <payload>/packages/dot/bootstrap.sh /path/to/fleet" >&2
  exit 2
fi

if [ ! -f "$root/$entry" ]; then
  echo "fleet: $origin names $root, which has no $entry." >&2
  echo "       $remedy" >&2
  exit 2
fi

# Refuse a checkout whose dependencies are not installed, for the reason bootstrap.sh gives:
# without this the first thing the operator sees is a module-resolution stack from inside
# effect, which reads as a broken CLI rather than as a missing `bun install`.
if [ ! -d "$root/node_modules/effect" ]; then
  echo "fleet: $root has no node_modules/effect." >&2
  echo "       run: cd $root && bun install" >&2
  exit 2
fi

exec bun "$root/$entry" "$@"
