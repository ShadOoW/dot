# The AWS CLI and every AWS SDK read this file. No secret belongs here: credentials live in
# ~/.aws/sso/cache, written by `aws sso login` and renewed by the CLI and the SDKs on their own.

# Bruce's AWS account, through the company's IAM Identity Center. `brucelee dev sms` hands the
# sms AWS_PROFILE=bruce instead of keys, so the server renews its own credentials while it runs.
[profile bruce]
sso_session = bruce
sso_account_id = 300005642526
sso_role_name = AdministratorAccess
region = eu-west-3

[sso-session bruce]
sso_start_url = https://identitycenter.amazonaws.com/ssoins-665641b78a4e4022
sso_region = eu-west-3
sso_registration_scopes = sso:account:access
