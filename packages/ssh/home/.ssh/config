# github — named because the key is not the same file on every machine. The
# laptop authenticates with ~/.ssh/id_ed25519; the desktop has a dedicated
# ~/.ssh/id_github. Both are listed and ssh tries them in order, skipping the
# one that is absent; NO IdentitiesOnly, precisely so that a machine with only
# one of the two still works.
#
# Without this, a machine holding both keys offers id_ed25519 first, GitHub
# rejects it, and the whole operation fails as
#   git@github.com: Permission denied (publickey).
# which reads like a missing key rather than the wrong one being tried.
Host github.com
    User git
    IdentityFile ~/.ssh/id_github
    IdentityFile ~/.ssh/id_ed25519

Host ssh.shadhq.com
ProxyCommand cloudflared access ssh --hostname %h
ServerAliveInterval 30
ServerAliveCountMax 3

# --- all-to-all SSH mesh — SHARED config (stow package `ssh`; used by desktop AND laptop). ---
# See /data/ops/ssh-mesh/README.md. hawk (the Hetzner server) by its PUBLIC IP + id_ed25519 (globally reachable,
# survives a tailnet/Headscale outage); the rest by tailnet MagicDNS name (location-independent).
# `phone` = LAN-direct .12 (fast at home); `phone-tail` = when the phone is remote + Tailscale on.
# Phone gets a COPY of this file over SSH (it has no dotfiles) — re-push after edits, see README.
# 2026-08-08: the phone is a NEW device (OnePlus Ace 5, LineageOS). `User u0_a213` is that
# device's Termux name — app-UID-derived, so a Termux (or OS) reinstall CHANGES it. On change,
# refresh both blocks here AND /data/ops/hosts/registry.json (which the autofs map is
# generated from), then re-push this file to the phone. Runbook: /data/ops/PHONE-SETUP.md.

# punk from INSIDE the desktop container is 10.42.0.1, not .10.
#
# The guest's lan0 is a macvlan on punk's own enp3s0, and a macvlan interface
# cannot talk to its parent host — so the one address on the house LAN this
# container can never reach is punk's. `ssh punk` from the desk dies with "No
# route to host" while the identical line works from the MacBook. The route
# that does exist is the Incus bridge, where punk answers on 10.42.0.1 (and
# where NFS and AdGuard already answer).
#
# A Match rather than a second Host alias, because this file is SHARED with
# the laptop and the phone and `punk` should mean the same machine from all of
# them. The test is for the container itself — /dev/incus/sock exists only
# inside an Incus guest — so every other machine skips it and keeps the .10
# below. It MUST sit above `Host punk`: ssh keeps the FIRST value it obtains
# for a keyword, not the last.
Match host punk exec "test -S /dev/incus/sock"
    HostName 10.42.0.1

# punk — the NixOS host (ragnarok). LAN-direct by its static .10 lease, which
# is pinned by client-id rather than MAC so it survives a NIC change. `admin`
# is the host account: nixos-rebuild, zpool, incus, sudo. `shad` on punk is a
# uid-1000 ownership record with nologin — the person called shad logs into the
# desktop CONTAINER, not into punk.
Host punk
    HostName 192.168.88.10
    User admin
    IdentityFile ~/.ssh/id_ed25519

# Same machine over the tailnet, for when you are not on the house LAN.
Host punk-tail
    HostName punk.tail.shadhq.com
    User admin
    IdentityFile ~/.ssh/id_ed25519

# The desktop container by its own static LAN address (macvlan, .13), as
# opposed to `desktop` below which goes over the tailnet. Root, because that is
# what hosts/desktop authorizes keys for — it is the deploy target.
Host desktop-lan
    HostName 192.168.88.13
    User root
    IdentityFile ~/.ssh/id_ed25519

Host hawk
    HostName 138.201.90.131
    User admin
    IdentityFile ~/.ssh/id_ed25519

# Same machine over the tailnet (hawk.tail.shadhq.com), as punk-tail.
Host hawk-tail hawk.tail.shadhq.com
    HostName hawk.tail.shadhq.com
    User admin
    IdentityFile ~/.ssh/id_ed25519

Host desktop
    HostName desktop.tail.shadhq.com
    User shad
    IdentityFile ~/.ssh/id_ed25519

Host laptop mac
    HostName laptop.tail.shadhq.com
    User youneselalami
    IdentityFile ~/.ssh/id_ed25519
    # kitty sends TERM=xterm-kitty, which the Mac has no terminfo for: zsh and
    # bat there then misdraw ("terminal is not fully functional", echoed keys).
    # OpenSSH >= 8.7 lets SetEnv override the pty's TERM.
    SetEnv TERM=xterm-256color

Host phone
    HostName 192.168.88.12
    Port 8022
    User u0_a213
    IdentityFile ~/.ssh/id_ed25519

Host phone-tail
    HostName phone.tail.shadhq.com
    Port 8022
    User u0_a213
    IdentityFile ~/.ssh/id_ed25519

Host router
    HostName 192.168.88.1
    User admin
