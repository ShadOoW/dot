Host ssh.shadhq.com
ProxyCommand cloudflared access ssh --hostname %h
ServerAliveInterval 30
ServerAliveCountMax 3

# --- all-to-all SSH mesh — SHARED config (stow package `ssh`; used by desktop AND laptop). ---
# See /data/ops/ssh-mesh/README.md. barzakh by its PUBLIC IP + id_ed25519 (globally reachable,
# survives a tailnet/Headscale outage); the rest by tailnet MagicDNS name (location-independent).
# `phone` = LAN-direct .12 (fast at home); `phone-tail` = when the phone is remote + Tailscale on.
# Phone gets a COPY of this file over SSH (it has no dotfiles) — re-push after edits, see README.
# 2026-08-08: the phone is a NEW device (OnePlus Ace 5, LineageOS). `User u0_a213` is that
# device's Termux name — app-UID-derived, so a Termux (or OS) reinstall CHANGES it. On change,
# refresh both blocks here AND /data/ops/hosts/registry.json (which the autofs map is
# generated from), then re-push this file to the phone. Runbook: /data/ops/PHONE-SETUP.md.
Host barzakh
    HostName 138.201.90.131
    User shad
    IdentityFile ~/.ssh/id_ed25519

Host desktop
    HostName desktop.tail.shadhq.com
    User shad
    IdentityFile ~/.ssh/id_ed25519

Host laptop mac
    HostName laptop.tail.shadhq.com
    User youneselalami
    IdentityFile ~/.ssh/id_ed25519

Host phone
    HostName 192.168.88.12
    Port 8022
    User u0_a213
    IdentityFile ~/.ssh/id_ed25519

Host phone-tail
    HostName phone.tail.shadhq.com
    Port 8022
    User u0_a213
    IdentityFile ~/.ssh/id_ed25519

Host router
    HostName 192.168.88.1
    User admin
