ServerAliveInterval 30
ServerAliveCountMax 3

Host barzakh
    HostName 138.201.90.131
    User shad
    IdentityFile ~/.ssh/hetzner-barzakh

# --- all-to-all SSH mesh (see /data/ops/ssh-mesh/README.md) ---
# This host (desktop) is stationary/always-home, so it reaches the phone LAN-direct (.12,
# reliable + fast, and independent of the phone's intermittent tailnet). The laptop is by its
# tailnet MagicDNS name (location-independent). barzakh stays on its PUBLIC IP + dedicated key
# above — globally reachable, survives a tailnet/Headscale outage. Use `phone-tail` only if
# the phone is ever remote AND its Tailscale is connected.
Host laptop mac
    HostName laptop.tail.shadhq.com
    User youneselalami
    IdentityFile ~/.ssh/id_ed25519

Host phone
    HostName 192.168.88.12
    Port 8022
    User u0_a399
    IdentityFile ~/.ssh/id_ed25519

Host phone-tail
    HostName phone.tail.shadhq.com
    Port 8022
    User u0_a399
    IdentityFile ~/.ssh/id_ed25519

Host router
    HostName 192.168.88.1
    User admin
