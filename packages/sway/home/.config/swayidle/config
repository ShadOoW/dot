# No lock screen at all on purpose: not on idle, not before sleep, no keybinding. The
# desk's account has no password (users are declared in the fleet's NixOS config with
# none), so swaylock can never be unlocked there. Going idle only blanks the outputs.

timeout 1200 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'
