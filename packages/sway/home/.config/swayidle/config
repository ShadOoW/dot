# No idle lock on purpose. Going idle blanks the outputs below but never asks for a
# password — locking is manual only ($mod+l, keybindings:187). Re-adding a `timeout N
# swaylock` here is the one thing that undoes that.

timeout 1200 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'

before-sleep 'swaylock --screenshots --clock --indicator'
