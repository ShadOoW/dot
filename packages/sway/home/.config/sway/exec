exec_always {
    ~/.config/sway/scripts/workspace-backgrounds.sh
}

exec {
    mako &
    swayidle &

    # Critical OOM notification. On Arch this is a systemd *user* unit (oom-notify.service);
    # Void has no systemd user manager, so the sway session owns it there instead — which is
    # the right owner anyway, since notify-send needs this session's D-Bus. Guarded rather
    # than unconditional so Arch does not end up running two copies.
    [ -d /run/systemd/system ] || ~/.local/bin/oom-notify &

    # Workspaces 3/4 are reserved for scripted project layouts
    # (dot session restore) — autotiling would fight the tabbed containers.
    autotiling-rs 5 6 7 8 9 10 &
    wl-paste --watch cliphist -db-path /data/stash/clipboard/cliphist -max-items 1000000 store &

    # Start MRU focus tracker for Alt-Tab behavior
    ~/.config/sway/scripts/sway_mru_daemon.py &

    # mpd, Void only. On Arch this is a systemd *user* unit (packages/mpd/meta.json), which is
    # what makes ~/.config/mpd/mpd.conf and the user's PipeWire sink reachable. Void's packaged
    # /etc/sv/mpd is a SYSTEM service running as user `mpd` against /etc/mpd.conf: it would
    # ignore this repo's config entirely and could not open shad's PipeWire socket, so it is
    # deliberately not enabled and the session owns mpd instead. ncmpcpp (mod+m) is useless
    # without it — it connects to 127.0.0.1:6600.
    if [ ! -d /run/systemd/system ] && command -v mpd >/dev/null 2>&1; then mpd; fi &

    # Pre-warm scratchpad apps — for_window rules handle mark + scratchpad.
    #
    # The two that exec a child binary are guarded. When the binary is absent kitty still
    # maps a window, that window still matches the app_id rule and still takes the mark, so
    # mod+m dutifully presented a dead terminal reading "Failed to launch child: ncmpcpp /
    # No such file or directory / Press Enter or Esc to exit". Guarding means a missing app
    # yields no scratchpad window at all, and the keybinding's own launch path reports it
    # instead of caching a corpse for the rest of the session.
    kitty --single-instance --app-id terminal-mark &
    command -v ncmpcpp >/dev/null 2>&1 && kitty --single-instance --app-id music-mark ncmpcpp &
    command -v yazi >/dev/null 2>&1 && kitty --single-instance --app-id yazi-explorer yazi &

    # Start browser
    vivaldi-stable &
    # Rebuilds the snapshot taken by `dot session reboot`/`save`; silent no-op when nothing
    # is armed. Consumes a one-shot token, so it fires once per save.
    #
    # `recover` runs AFTER it, not alongside, and the ordering is load-bearing. Reading
    # transcript mtimes cannot tell an orderly shutdown from a crash, so the only thing that
    # distinguishes them is whether those sessions are live again — and restore is what makes
    # them live. Run concurrently, recover finishes in ~0.1s while restore is still waiting on
    # windows, and every planned reboot would announce itself as a crash.
    dot session restore --if-pending && dot session recover --notify &
}
