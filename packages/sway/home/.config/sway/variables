### Variables
#
# Logo key. Use Mod1 for Alt.
set {
    $mod Mod4
    $term kitty
    $menu ~/.config/fuzzel-scripts/app-launcher.sh
    $window ~/.config/rofi/open-close.sh "rofi -show sway-windows -modi 'sway-windows:/home/shad/.config/rofi/scripts/sway-windows.sh' -selected-row $(/home/shad/.config/rofi/scripts/sway-windows.sh --focused-index)"
    $clipboard ~/.config/fuzzel-scripts/clipboard.sh
    $clipboard_delete ~/.config/fuzzel-scripts/clipboard.sh --delete
    $images ~/.config/fuzzel-scripts/images.sh
    $commands ~/.config/rofi/open-close.sh "~/.config/rofi/custom-commands.sh"
    $projects ~/.config/rofi/open-close.sh "~/.config/kitty/scripts/project-manager.sh"
    
    # Scratchpad settings
    $sp_terminal "~/.config/sway/scripts/toggle-scratchpad.sh terminal app_id terminal-mark 'kitty --app-id terminal-mark'"
    $sp_music "~/.config/sway/scripts/toggle-scratchpad.sh music app_id music-mark 'kitty --app-id music-mark ncmpcpp'"
    $sp_explorer "~/.config/sway/scripts/toggle-scratchpad.sh explorer app_id yazi-explorer 'kitty --app-id yazi-explorer yazi'"
    $sp_chatgpt "~/.config/sway/scripts/toggle-scratchpad.sh chatgpt app_id org.qutebrowser.qutebrowser 'qutebrowser https://chatgpt.com'"
    $sp_whatsapp "~/.config/sway/scripts/toggle-scratchpad.sh whatsapp app_id org.qutebrowser.qutebrowser 'whatsapp https://web.whatsapp.com'"
}
