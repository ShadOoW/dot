include ./variables
include ./output
include ./keybindings
include ./rules
include ./styling
include /etc/sway/config.d/*

# LAST on purpose. Sway reads this file top-to-bottom, so anything that spawns a client must
# come after the `for_window` rules that classify it. With `include ./exec` third, the
# pre-warmed scratchpad kitties were launched while the rules that give them
# `floating enable, mark <name>, move scratchpad` had not been registered yet — a window that
# wins that race maps unmarked, mod+z/mod+m then find no marked window and launch a duplicate,
# and because sway marks are unique the duplicate steals the mark and strands the original
# unmarked and invisible in the scratchpad. Being last also means these execs observe the
# environment from config.d (50-systemd-user.conf) instead of racing it.
include ./exec

# Session-scoped user services (polkit agent, mpd, sunshine…) hang off the session target.
# 50-systemd-user.conf (included above) imports WAYLAND_DISPLAY et al, but sway
# execs are async — re-import in the same shell so the target's units never race it.
#
# sway-session.target first, graphical-session.target only as the fallback. Where a distro
# ships the sway unit files (nixpkgs' sway module, and systemd's own upstream layout),
# graphical-session.target carries RefuseManualStart=yes — it exists to be pulled in by a
# session target, never poked directly — so starting it prints
#   Failed to start graphical-session.target: Operation refused …
# on every login while the units that matter are already up. Arch and Void have no
# sway-session.target, so there the `||` branch runs exactly as before.
exec "systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP; systemctl --user start sway-session.target 2>/dev/null || systemctl --user start graphical-session.target"
