#!/bin/sh
# Sway wrapper to capture logs to ~/.local/state/sway/logs/
# Force Intel iGPU for Wayland, where there is one.

# The real compositor, which is not at a fixed path on every host: Arch and
# Void install /usr/bin/sway, NixOS puts it in /run/current-system/sw/bin (and
# nothing at all in /usr/bin). `command -v` cannot be used — this file IS
# `sway` on PATH, so it would find itself and fork-bomb.
for _candidate in /usr/bin/sway /usr/local/bin/sway /run/current-system/sw/bin/sway; do
  if [ -x "$_candidate" ]; then
    SWAY_REAL=$_candidate
    break
  fi
done
if [ -z "${SWAY_REAL:-}" ]; then
  echo "sway: no sway binary found outside this wrapper." >&2
  exit 127
fi

# Flags that genuinely print and exit. They must not create a session log file, and must
# not reach the nesting guard below.
#
# `--validate`/`-C` is deliberately NOT here. It does not lint and exit: sway 1.12 falls
# through to the DRM backend, takes the card and fights the running session for DRM master
# (see ../../../README.md §Never run `sway` to check a config). Letting the guard reject it
# is the correct outcome — ask the running compositor with `swaymsg` instead.
case " $* " in
  *" --version "* | *" -v "* | *" --help "* | *" -h "* | \
    *" --get-socketpath "* | *" -p "*)
    exec "$SWAY_REAL" "$@"
    ;;
esac

# Refuse to boot a nested compositor from inside a running session. This wrapper used to
# drop "$@", so any `sway <arg>` typed in a terminal — `sway --version` included — silently
# started a second compositor that replayed the whole autostart against the live session:
# a duplicate mpvpaper, a lost fight over the notification-daemon name, and another
# `vivaldi-stable` whose singleton handoff SIGTRAPped the running browser (469 MB core,
# 2026-09-05). Nesting is still reachable through /usr/bin/sway when actually wanted.
if [ -n "$WAYLAND_DISPLAY" ] || [ -n "$SWAYSOCK" ]; then
  echo "sway: already inside a Wayland session; refusing to start a nested compositor." >&2
  echo "sway: run $SWAY_REAL directly if that is really what you want." >&2
  exit 1
fi

LOGDIR="$HOME/.local/state/sway/logs"
LOGFILE="$LOGDIR/sway-$(date +%Y%m%d-%H%M%S).log"

mkdir -p "$LOGDIR"

echo "=== Sway wrapper started at $(date) ===" >"$LOGFILE"
echo "Log file: $LOGFILE" >>"$LOGFILE"
echo "PID: $$" >>"$LOGFILE"

# The display GPU. On the Arch/Void box that is the Alder Lake iGPU, named by
# PCI path so it survives card renumbering. Where that node does not exist —
# punk's desktop container is given ONE card, the 3060, and no iGPU at all —
# pinning it would hand wlroots an empty WLR_DRM_DEVICES and the compositor
# would find no device to render on. So it is applied only when it is there.
INTEL_PATH="/dev/dri/by-path/pci-0000:00:02.0-card"
INTEL_DEV=$(readlink -f "$INTEL_PATH" 2>/dev/null)
if [ -n "$INTEL_DEV" ] && [ -e "$INTEL_DEV" ]; then
  export WLR_DRM_DEVICES="$INTEL_DEV"
  echo "Using Intel GPU: $INTEL_DEV (from $INTEL_PATH)" >>"$LOGFILE"
else
  echo "No iGPU at $INTEL_PATH — leaving device selection to wlroots" >>"$LOGFILE"
fi

# Stop advertising wp_linux_drm_syncobj_manager_v1 (Wayland explicit sync).
#
# Chromium binds that protocol unconditionally whenever the compositor offers it and the
# kernel is >= 6.11 (ui/ozone/platform/wayland/host/wayland_connection.cc) — there is no
# Chromium switch or feature flag to opt out, so the only place to turn it off is here.
# It then waits for a release-timeline point per surface; if one never gets signalled,
# that one toplevel stops producing frames and stops taking input forever, while every
# other toplevel of the same process keeps working. That is exactly the Vivaldi wedge
# measured on 2026-09-13 (see ../../../browsers/README.md): unmap/remap and every focus
# trick failed, only restarting the GPU process helped, and only briefly.
#
# Cost: implicit sync instead. Display is the Intel iGPU (WLR_DRM_DEVICES above), where
# implicit sync is the path everything used before wlroots 0.18; explicit sync mainly
# buys NVIDIA clients tear-free presentation, so watch NVIDIA-offloaded games for
# flicker. Revert by deleting this export, and verify with:
#   wayland-info | grep syncobj      # present again = explicit sync back on
export WLR_RENDER_NO_EXPLICIT_SYNC=1
echo "Explicit sync disabled (WLR_RENDER_NO_EXPLICIT_SYNC=1)" >>"$LOGFILE"

exec "$SWAY_REAL" "$@" 2>>"$LOGFILE"
