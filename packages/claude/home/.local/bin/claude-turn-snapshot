#!/bin/sh
# Claude Code hook: snapshot the working tree into a ref so nvim can diff
# "what the agent changed this turn" instead of "working tree vs HEAD".
#
#   UserPromptSubmit -> claude-turn-snapshot turn-base
#   SessionStart     -> claude-turn-snapshot session-base
#
# `git stash create` builds a commit from the current tracked state without
# touching the index, working tree, or stash list; update-ref keeps it
# reachable (gc-safe). Clean tree falls back to HEAD. Untracked files are not
# part of the snapshot — they still show up as "new" when diffing against it.
#
# Must stay silent on stdout: UserPromptSubmit hook output is injected into
# the conversation context.

ref="refs/claude/${1:-turn-base}"
cd "${CLAUDE_PROJECT_DIR:-.}" 2>/dev/null || exit 0
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0
sha=$(git stash create 2>/dev/null)
[ -n "$sha" ] || sha=$(git rev-parse HEAD 2>/dev/null) || exit 0
git update-ref "$ref" "$sha" 2>/dev/null || true
