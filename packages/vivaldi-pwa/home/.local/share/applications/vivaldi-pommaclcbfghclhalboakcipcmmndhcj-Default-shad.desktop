# Hand-written 2026-09-23, not a Vivaldi file: same installed web app as
# `vivaldi-pommaclcbfghclhalboakcipcmmndhcj-Default.desktop` (which is pinned to the work
# account), launched into the personal account via `?authuser=<email>`. One app id, two
# launchers -- Vivaldi only knows the one PWA, so it never writes or rewrites this file.
#
# The `-shad` suffix keeps it out of windows.sh's `vivaldi-*-Default.desktop` glob: both
# windows carry the same app_id, and that script wants exactly one name per app id.
#
# Limitation, verified 2026-09-23: Google Chat's manifest declares launch_handler
# focus-existing, so while any Chat window is open a launch (this one or the work one)
# only focuses that window and drops the URL -- `--app=<url>` is captured the same way.
# Close the open Chat window first. Gmail has no such handler; its two entries coexist.
[Desktop Entry]
Version=1.0
Terminal=false
Type=Application
Name=Google Chat Shad
Exec=vivaldi-stable --profile-directory=Default --app-id=pommaclcbfghclhalboakcipcmmndhcj --app-launch-url-for-shortcuts-menu-item=https://chat.google.com/?authuser=shadoow.ma@gmail.com
Icon=vivaldi-pommaclcbfghclhalboakcipcmmndhcj-Default
StartupWMClass=crx_pommaclcbfghclhalboakcipcmmndhcj
